# /etc/notify/secrets.env   — 0600 root:root
#
# Read by /usr/local/sbin/notify only: the ntfy topic for its pushes, and each
# unit's healthchecks.io ping URL. Treated as optional — a missing key skips
# that ping, because a job must never fail on account of its own monitoring.
#
# EVERY VALUE IS A SECRET, in different ways:
#
#   HC_*        — anyone holding one can report that job as healthy, which is
#                 worse than useless: it silences the alarm you installed.
#   NTFY_TOPIC  — on the public ntfy.sh, a topic name IS the credential. Anyone
#                 who knows it can both read your alerts and publish fake ones.
#                 Use a long random name; treat it like a password.
#
# Keep this file out of version control (0600, outside any repo). Record only
# its *path* in your host notes, never its contents.

# Topic name only, not a URL.
NTFY_TOPIC=change-me-to-something-long-and-random

# One check per unit, so a fault names the job that broke: one URL for both
# would let a failed database dump mark the restic run's period red and send
# you to the wrong place at 3am. The key is HC_ plus the unit name without
# ".service", upper-cased, `-` as `_`. Ping URL only, no trailing slash —
# notify appends /fail. A key left out skips that unit's pings.
#
# Nightly restic run (mixtape-restic.service):
HC_MIXTAPE_RESTIC=https://hc-ping.com/00000000-0000-0000-0000-000000000000
# Nightly database dump (mixtape-db-backup.service):
HC_MIXTAPE_DB_BACKUP=https://hc-ping.com/00000000-0000-0000-0000-000000000000
