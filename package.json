{
    "name": "mixtape",
    "description": "MixTape - self-hosted personal mp3 / audiobook collection player",
    "license": "MIT",
    "private": true,
    "version": "2.2.0",
    "type": "module",
    "engines": {
        "node": "^26.4.0",
        "npm": "^11.17.0"
    },
    "author": {
        "name": "Sven Scharfenberg"
    },
    "scripts": {
        "dev": "npm run preinstall && vite --host",
        "build": "npm run preinstall && npm run lint && run-p type-check \"build-only {@}\" --",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "lint": "eslint 'resources/**/*.{js,ts,vue}' 'tests/e2e/**/*.ts' vite.config.ts vitest.config.ts playwright.config.ts --fix && stylelint 'resources/**/*.{vue,scss}' --fix --quiet-deprecation-warnings && npm run i18n:check",
        "i18n:check": "node ./resources/build/checkTranslations.ts",
        "icons": "node ./resources/build/icons.ts -v -i",
        "og": "node ./resources/build/ogImage.ts",
        "format": "prettier --write 'resources/{app,build,types}/**/*.{ts,vue,scss,json,md}'",
        "preinstall": "node ./resources/build/checkNodeVersion.ts"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.8.0",
        "@sscharfenberg/progressbar": "^0.2.1",
        "normalize.css": "^8.0.1",
        "sortablejs": "^1.15.7",
        "vue": "^3.5.43",
        "vue-i18n": "^11.4.13",
        "vue-input-otp": "^0.4.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/minimist": "^1.2.5",
        "@types/node": "^26.6.4",
        "@types/semver": "^7.8.0",
        "@types/sortablejs": "^1.15.9",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "chalk": "^6.0.1",
        "eslint": "^10.12.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-vue": "^10.11.1",
        "happy-dom": "^20.14.5",
        "jiti": "^2.7.0",
        "laravel-vite-plugin": "^3.2.0",
        "lightningcss": "^1.33.0",
        "minimist": "^1.2.8",
        "npm-run-all2": "^9.0.3",
        "playwright": "^1.63.0",
        "prettier": "3.9.9",
        "sass-embedded": "^1.105.1",
        "semver": "^7.8.5",
        "sharp": "^0.35.5",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-config-standard-vue": "^2.0.0",
        "stylelint-order": "^8.1.1",
        "stylelint-scss": "^7.3.0",
        "svgo": "^4.1.0",
        "svgstore": "^3.0.1",
        "typescript": "~6.0.3",
        "vite": "^8.3.2",
        "vite-plugin-image-optimizer": "^2.0.3",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.3",
        "vue-tsc": "^3.3.12"
    },
    "prettier": {
        "printWidth": 120,
        "tabWidth": 4,
        "semi": true,
        "singleQuote": false,
        "singleAttributePerLine": false,
        "trailingComma": "none",
        "bracketSpacing": true,
        "arrowParens": "avoid",
        "overrides": [
            {
                "files": "**/*.yml",
                "options": {
                    "tabWidth": 2
                }
            }
        ]
    },
    "allowScripts": {
        "vue-demi@0.14.10": true,
        "unrs-resolver@1.12.2": true,
        "@parcel/watcher@2.6.0": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true
    }
}
