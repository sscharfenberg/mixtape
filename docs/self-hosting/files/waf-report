#!/usr/bin/env python3
# /usr/local/sbin/waf-report   — 750 root:root
#
# The daily report of the requests the WAF refused, for every app on the box,
# run by waf-report.timer. A WAF 403 never reaches the app, so a false positive
# in an app's exclusions (/etc/nginx/modsec/<app>.conf) would otherwise go
# unnoticed: the visitor sees a 403 and nobody else learns of it. No fail2ban
# jail acts on these refusals: every one of them is already refused, and a jail
# would turn a false positive into a ban of a real user.
#
# The apps are in /etc/waf-report/apps.json (files/waf-report.apps.json is the
# template): each names its hosts, its session cookie, its exclusions file and
# its channels. One script and one timer for all of them, so the parsing below
# exists once.
#
# A refusal counts as a VISITOR'S when the request carried the app's session
# cookie AND at least one rule besides the scanner rules matched AND its client
# made no scanner-only refusal in the same window. The cookie alone is not
# enough: a scanner keeps a cookie from its first response, and its probes for
# backup files and dotfiles (920440, 930130, 920500 — rules that fire on file
# NAMES no app serves) then carry it — measured on one app, 20 of 383 refusals
# in two weeks, every one of them a scanner. The same scanner's PAYLOADS (a
# shell expression POSTed to /, say) trip ordinary rules, so its client gives
# it away instead: no visitor's browser asks for /phpinfo.php.bak, and a client
# that did is a scanner for the whole window. Only when an app has
# at least one visitor refusal in the window does its report go out, through
# that app's channels, each sent on its own so one failing does not cost the
# others. Everything else is only counted. The full list, with times and
# clients, goes to the journal:
#   journalctl -u waf-report
#
# The report names the path (ids folded to {id}), the rules and the request
# field each rule matched in. It never names the matched value, the query
# string or the client address: those are the visitor's, and every channel is a
# third party.
#
# Each app has its own window, from the end of its previous successful run's
# window to one second ago; the first run looks back a day. An app whose report
# reached none of its channels keeps its old window start, so the next run
# reports the gap as well, and the run exits non-zero. A report that reached
# some channels but not all moves the window on and exits non-zero.
#
#   --dry-run       print the reports instead of sending them; windows stay
#   --since ISO     start every window here, e.g. 2026-11-23T00:00:00 (server
#                   time); the saved window starts stay (to test delivery)
#   --app NAME      only this app
#   --config PATH   the apps file (default /etc/waf-report/apps.json, or
#                   $WAF_REPORT_CONFIG)

import argparse
import collections
import datetime
import email.message
import email.utils
import glob
import gzip
import json
import os
import re
import smtplib
import ssl
import sys
import traceback
import urllib.request

DEFAULT_CONFIG = "/etc/waf-report/apps.json"
DEFAULT_AUDIT_LOGS = "/var/log/modsecurity/audit.log*"
STATE_DIR = os.environ.get("STATE_DIRECTORY", "/var/lib/waf-report")
# A WAF denial answers 403 (rule matches), 400 (an unparsable body) or 413 (a
# body over the limit). Matches under the anomaly threshold pass with the app's
# own status and are only counted.
REFUSED_STATUSES = {400, 403, 413}
# The anomaly-score verdicts: they say that a request was refused, not why.
VERDICT_RULES = {"949110", "980130", "959100"}
# Rules that fire on a requested file NAME — a backup extension (920440), a
# restricted file such as .env or .git (930130), a restricted file extension
# (920500). No app serves such a path, so a refusal carrying nothing else is a
# scanner's, whatever cookie it holds.
SCANNER_RULES = {"920440", "930130", "920500"}
MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
UUID = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.IGNORECASE)
# "Matched Data: … found within ARGS:json.text: <value>" -> ARGS:json.text
MATCHED_IN = re.compile(r"within ([A-Z_]+(?::[^\s:]+)?)")
DISCORD_LIMIT = 4000
NTFY_LIMIT = 3800


def env_value(path, key):
    """One KEY=value from a dotenv-style file, quotes stripped; '' when absent or unreadable."""
    try:
        with open(path) as f:
            for line in f:
                m = re.match(rf"^\s*{re.escape(key)}\s*=\s*(.*?)\s*$", line)
                if m:
                    return m.group(1).strip("'\"")
    except OSError:
        pass
    return ""


def send_ntfy(channel, title, text, failed):
    """A push to the app's ntfy topic. The topic name is the credential, so it is read from a root-only file."""
    topic = env_value(channel["env_file"], channel.get("topic_key", "NTFY_TOPIC"))
    if not topic:
        raise RuntimeError(f"no {channel.get('topic_key', 'NTFY_TOPIC')} in {channel['env_file']}")
    server = channel.get("server", "https://ntfy.sh").rstrip("/")
    request = urllib.request.Request(
        f"{server}/{topic}",
        data=text.encode()[:NTFY_LIMIT],
        headers={
            "Title": title,
            "Priority": "urgent" if failed else "high",
            "Tags": "rotating_light" if failed else "shield",
            "User-Agent": "waf-report",
        },
    )
    with urllib.request.urlopen(request, timeout=10):
        pass


def send_discord(channel, title, text, failed):
    """An embed through the app's Discord webhook, read from the app's own .env."""
    webhook = env_value(channel["env_file"], channel.get("webhook_key", "DISCORD_WEBHOOK_URL"))
    if not webhook:
        raise RuntimeError(f"no {channel.get('webhook_key', 'DISCORD_WEBHOOK_URL')} in {channel['env_file']}")
    color = 0xD32F2F if failed else 0xF57C00
    payload = {"embeds": [{"title": title, "description": text[:DISCORD_LIMIT], "color": color}]}
    request = urllib.request.Request(
        webhook,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", "User-Agent": "waf-report"},
    )
    with urllib.request.urlopen(request, timeout=10):
        pass


def send_mail(channel, title, text, failed):
    """A mail through the app's own SMTP settings, to the address its .env names (APP_CONTACT by default)."""
    env_file = channel["env_file"]
    to_key = channel.get("to_key", "APP_CONTACT")
    env = {key: env_value(env_file, key) for key in (
        "MAIL_HOST", "MAIL_PORT", "MAIL_SCHEME", "MAIL_USERNAME", "MAIL_PASSWORD",
        "MAIL_FROM_ADDRESS", "MAIL_FROM_NAME", to_key,
    )}
    missing = [key for key in ("MAIL_HOST", "MAIL_FROM_ADDRESS", to_key) if not env[key]]
    if missing:
        raise RuntimeError(f"no {', '.join(missing)} in {env_file}")
    message = email.message.EmailMessage()
    message["Subject"] = title
    message["From"] = email.utils.formataddr((env["MAIL_FROM_NAME"], env["MAIL_FROM_ADDRESS"]))
    message["To"] = env[to_key]
    message.set_content(text)
    port = int(env["MAIL_PORT"] or 587)
    context = ssl.create_default_context()
    if env["MAIL_SCHEME"] == "smtps" or port == 465:
        server = smtplib.SMTP_SSL(env["MAIL_HOST"], port, timeout=20, context=context)
    else:
        server = smtplib.SMTP(env["MAIL_HOST"], port, timeout=20)
        server.starttls(context=context)
    with server:
        if env["MAIL_USERNAME"]:
            server.login(env["MAIL_USERNAME"], env["MAIL_PASSWORD"])
        server.send_message(message)


def send_file(channel, title, text, failed):
    """Appends the report to a file: for trying a configuration, and for the tests."""
    with open(channel["path"], "a") as f:
        f.write(f"{title}\n{text}\n---\n")


SENDERS = {"ntfy": send_ntfy, "discord": send_discord, "mail": send_mail, "file": send_file}


def deliver(app, title, text, failed=False):
    """Every channel of the app, each on its own. Returns the channels that failed."""
    plain = text.replace("**", "").replace("`", "")
    failures = []
    for channel in app["channels"]:
        kind = channel["type"]
        try:
            SENDERS[kind](channel, title, text if kind == "discord" else plain, failed)
            print(f"{app['name']}: {kind}: sent")
        except Exception as error:
            failures.append(f"{kind} ({type(error).__name__}: {str(error)[:200]})")
            print(f"{app['name']}: {kind}: failed ({type(error).__name__}: {str(error)[:200]})", file=sys.stderr)
    return failures


def audit_timestamp(value):
    """'Mon Nov 23 06:41:35 2026' (server time) -> datetime, independent of the locale."""
    _, month, day, clock, year = value.split()
    hour, minute, second = (int(part) for part in clock.split(":"))
    return datetime.datetime(int(year), MONTHS.index(month) + 1, int(day), hour, minute, second)


def audit_lines(pattern, since):
    """Every line of every audit log written to after `since`, oldest file first."""
    paths = [p for p in glob.glob(pattern) if os.path.getmtime(p) > since.timestamp()]
    for path in sorted(paths, key=os.path.getmtime):
        opener = gzip.open if path.endswith(".gz") else open
        with opener(path, "rt", encoding="utf-8", errors="replace") as f:
            yield from f


def app_for(transaction, hosts, http3_app):
    """The app a transaction belongs to, by its Host; HTTP/3 arrives without one (nginx hands
    ModSecurity no Host for it, taking the name from :authority), so it goes to the one app that
    speaks HTTP/3, if the config names one."""
    headers = {k.lower(): v for k, v in transaction["request"].get("headers", {}).items()}
    host = headers.get("host", "").split(":")[0].lower()
    if not host and transaction["request"].get("http_version") == 3.0:
        return http3_app, headers
    return hosts.get(host), headers


def is_visitor(app, headers, findings):
    """The app's session cookie AND a rule that is not a scanner's: see the header comment.
    The third condition, the client's other refusals, needs the whole window (see collect)."""
    cookies = headers.get("cookie", "")
    has_session = re.search(rf"(?:^|;\s*){re.escape(app['session_cookie'])}=", cookies) is not None
    return has_session and any(rule not in SCANNER_RULES for rule, _, _ in findings)


def is_scanner_probe(findings):
    """A refusal on file-name rules alone — a request no app's own page ever makes."""
    rules = {rule for rule, _, _ in findings}
    return bool(rules) and rules <= SCANNER_RULES


def collect(config, apps, since):
    """Every refusal in the window, per app, plus what was only counted."""
    hosts = {host.lower(): app for app in apps for host in app["hosts"]}
    http3_app = next((app for app in apps if app.get("http3_default")), None)
    results = {app["name"]: {"refusals": [], "passed": 0} for app in apps}
    unreadable = 0
    earliest = min(since[app["name"]] for app in apps)
    for line in audit_lines(config.get("audit_logs", DEFAULT_AUDIT_LOGS), earliest):
        try:
            transaction = json.loads(line)["transaction"]
            app, headers = app_for(transaction, hosts, http3_app)
            if app is None:
                continue
            when = audit_timestamp(transaction["time_stamp"])
        except (ValueError, KeyError, TypeError):
            unreadable += 1
            continue
        result = results[app["name"]]
        messages = transaction.get("messages") or []
        # An entry without messages was logged for its 5xx status alone.
        if not (since[app["name"]] < when <= since["until"]) or not messages:
            continue
        if transaction.get("response", {}).get("http_code") not in REFUSED_STATUSES:
            result["passed"] += 1
            continue
        findings = []
        for message in messages:
            details = message.get("details", {})
            rule = details.get("ruleId", "")
            if rule in VERDICT_RULES:
                continue
            matched_in = MATCHED_IN.search(details.get("data", ""))
            findings.append((rule, message.get("message", ""), matched_in.group(1) if matched_in else ""))
        request = transaction["request"]
        result["refusals"].append({
            "when": when,
            "client": transaction.get("client_ip", "?"),
            "id": transaction.get("unique_id", "?"),
            "status": transaction["response"]["http_code"],
            "request": f"{request.get('method', '?')} {UUID.sub('{id}', request.get('uri', '').split('?')[0])}",
            "findings": findings,
            "visitor": is_visitor(app, headers, findings),
        })
    # A client that probed for file names in this window is a scanner for all of it.
    for result in results.values():
        scanners = {r["client"] for r in result["refusals"] if is_scanner_probe(r["findings"])}
        for refusal in result["refusals"]:
            refusal["visitor"] = refusal["visitor"] and refusal["client"] not in scanners
    return results, unreadable


def report_text(app, since, until, visitors, others, zone):
    """One app's report in Markdown (Discord's); the other channels get it with the markup stripped."""
    groups = collections.OrderedDict()
    rule_messages = {}
    for refusal in visitors:
        key = (refusal["request"], tuple(sorted({(rule, field) for rule, _, field in refusal["findings"]})))
        group = groups.setdefault(key, {"count": 0, "clients": set()})
        group["count"] += 1
        group["clients"].add(refusal["client"])
        for rule, text, _ in refusal["findings"]:
            rule_messages.setdefault(rule, text)

    lines = [
        f"{since:%Y-%m-%d %H:%M} – {until:%Y-%m-%d %H:%M} {zone}. These requests carried {app['label']}'s "
        "session cookie and tripped more than a scanner's file-name rules, so they were most likely the "
        f"app's own: a false positive in the WAF exclusions (`{app['exclusions']}`) looks like this.",
        "",
    ]
    for (request, findings), group in groups.items():
        clients = len(group["clients"])
        lines.append(f"**{group['count']}×** `{request}` ({clients} client{'s' if clients != 1 else ''})")
        for rule, field in findings:
            where = f" — in `{field}`" if field else ""
            lines.append(f"  {rule or '(no rule id)'} {rule_messages.get(rule, '')}{where}")
    lines += [
        "",
        f"Also refused, scanners and bots: {len(others)}.",
        "Details: `journalctl -u waf-report`",
    ]
    return "\n".join(lines)


def window_file(app):
    """Where an app's window end is kept between runs."""
    return os.path.join(STATE_DIR, f"{app['name']}.window-end")


def load_config(path):
    """The apps file, with the fields every app needs checked up front rather than at the first refusal."""
    with open(path) as f:
        config = json.load(f)
    for app in config["apps"]:
        for key in ("name", "label", "hosts", "session_cookie", "exclusions", "channels"):
            if key not in app:
                raise ValueError(f"app {app.get('name', '?')}: no '{key}' in {path}")
        for channel in app["channels"]:
            if channel.get("type") not in SENDERS:
                raise ValueError(f"app {app['name']}: unknown channel type {channel.get('type')!r}")
    if sum(1 for app in config["apps"] if app.get("http3_default")) > 1:
        raise ValueError(f"more than one app with http3_default in {path}")
    return config


def run(args):
    """Collect every app's window, report the apps with visitor refusals, and move the windows on.
    Returns {app name: what went wrong} for the apps whose delivery failed in part or whole."""
    config = load_config(args.config)
    apps = [app for app in config["apps"] if args.app in (None, app["name"])]
    if not apps:
        raise ValueError(f"no app {args.app!r} in {args.config}")

    until = datetime.datetime.now().replace(microsecond=0) - datetime.timedelta(seconds=1)
    since = {"until": until}
    for app in apps:
        if args.since is not None:
            since[app["name"]] = args.since
            continue
        try:
            with open(window_file(app)) as f:
                since[app["name"]] = datetime.datetime.fromisoformat(f.read().strip())
        except FileNotFoundError:
            since[app["name"]] = until - datetime.timedelta(days=1)
    zone = datetime.datetime.now().astimezone().tzname()

    results, unreadable = collect(config, apps, since)
    errors = {}
    for app in apps:
        refusals = results[app["name"]]["refusals"]
        visitors = [r for r in refusals if r["visitor"]]
        others = [r for r in refusals if not r["visitor"]]
        start = since[app["name"]]
        print(f"{app['name']}: window {start} – {until} {zone}: {len(visitors)} visitor request(s) refused, "
              f"{len(others)} other(s) refused, {results[app['name']]['passed']} matched but passed")
        for refusal in refusals:
            rules = ", ".join(f"{rule} {field}".strip() for rule, _, field in refusal["findings"]) or "-"
            kind = "visitor" if refusal["visitor"] else "other"
            print(f"  {refusal['when']}  {kind:<8} {refusal['client']:<39} {refusal['status']}  "
                  f"{refusal['request']}  [{rules}]  id={refusal['id']}")

        failures = []
        if visitors:
            title = f"{app['label']} WAF refused {len(visitors)} visitor request{'s' if len(visitors) != 1 else ''}"
            text = report_text(app, start, until, visitors, others, zone)
            if args.dry_run:
                print(f"\n--- {app['name']}: would send ---\n{title}\n{text}\n")
                continue
            failures = deliver(app, title, text)
            if len(failures) == len(app["channels"]):
                errors[app["name"]] = "report not delivered: " + "; ".join(failures)
                continue

        if not args.dry_run and args.since is None:
            os.makedirs(STATE_DIR, exist_ok=True)
            temporary = f"{window_file(app)}.tmp"
            with open(temporary, "w") as f:
                f.write(until.isoformat())
            os.replace(temporary, window_file(app))
        if failures:
            errors[app["name"]] = "report delivered, but not by " + "; ".join(failures)

    if unreadable:
        print(f"{unreadable} unreadable line(s) in the audit logs", file=sys.stderr)
    return errors


def alert_failure(apps, names, reason):
    """Tells each named app, through whichever of its channels still work, that its report failed."""
    for app in apps:
        if app["name"] in names:
            deliver(app, f"{app['label']} WAF report FAILED",
                    f"{reason[:400]}\nInspect with: journalctl -u waf-report -n 40", failed=True)


def main():
    """Parse the options and run. A delivery failure alerts only the app it belongs to; a crash
    before any app was handled alerts every app it can, since none of their reports went out."""
    parser = argparse.ArgumentParser(description="Report the requests the WAF refused, per app.")
    parser.add_argument("--dry-run", action="store_true", help="print the reports, send nothing, keep the windows")
    parser.add_argument("--since", type=datetime.datetime.fromisoformat, help="start of every window (server time)")
    parser.add_argument("--app", help="only this app")
    parser.add_argument("--config", default=os.environ.get("WAF_REPORT_CONFIG", DEFAULT_CONFIG))
    args = parser.parse_args()
    try:
        errors = run(args)
    except Exception as error:
        traceback.print_exc()
        if args.dry_run:
            sys.exit(1)
        try:
            apps = load_config(args.config)["apps"]
        except Exception:
            apps = []
        alert_failure(apps, {app["name"] for app in apps if args.app in (None, app["name"])},
                      f"{type(error).__name__}: {error}")
        sys.exit(1)
    if errors:
        apps = load_config(args.config)["apps"]
        for name, reason in errors.items():
            print(f"{name}: {reason}", file=sys.stderr)
            alert_failure(apps, {name}, reason)
        sys.exit(1)


if __name__ == "__main__":
    main()
