# /etc/mixtape/backup-alerts.env   — 0600 root:root
#
# Read by mixtape-backup-alert.sh and by the success pings in mixtape-restic.service
# and mixtape-db-backup.service. All treat it as optional: if it is missing or
# unreadable they simply do not ping, because a backup must never fail on account
# of its own monitoring.
#
# EVERY VALUE IS A SECRET, in different ways:
#
#   HC_*_PING_URL — anyone holding one can report that job as healthy, which is
#                   worse than useless: it silences the alarm you installed.
#   NTFY_TOPIC    — on the public ntfy.sh, a topic name IS the credential. Anyone
#                   who knows it can both read your alerts and publish fake ones.
#                   Use a long random name; treat it like a password.
#
# Keep this file out of version control (0600, outside any repo). Record only
# its *path* in your host notes, never its contents.

# Topic name only, not a URL.
NTFY_TOPIC=change-me-to-something-long-and-random

# Each job pings its own check, so a fault names the job that broke: one URL for
# both would let a failed database dump mark the restic run's period red and send
# you to the wrong place at 3am. Ping URL only, no trailing slash — the alert
# script appends /fail. An empty value skips that job's pings.
#
# Nightly restic run (mixtape-restic.service, success ping from the unit):
HC_RESTIC_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
# Nightly database dump (mixtape-db-backup.service, success ping from the unit):
HC_DB_PING_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
