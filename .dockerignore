# The dev image bind-mounts the source at runtime and only COPYs the entrypoint,
# so keep the build context tiny — don't ship the heavy dirs to the daemon.
.git
node_modules
vendor
storage/logs/*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*.php
public/build
public/hot
public/storage
docs/host.local
*.sqlite
