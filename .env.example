APP_NAME=MixTape
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- MixTape library scanner (php artisan app:update) ---
# Absolute server paths to each area of the collection. On the live box these
# sit under /var/media; point them at a local copy for dev. See config/mixtape.php.
# Leave an area empty (or unset) to disable it — app:update skips it (no rows
# touched) rather than failing. There are no code defaults; these values ARE the
# config. podcast_shows ships empty (many collections have none).
MIXTAPE_MUSIC_PATH=/var/media/music
MIXTAPE_AUDIOBOOKS_PATH=/var/media/audiobooks
MIXTAPE_PODCAST_SHOWS_PATH=
# Where a fatal, run-aborting scan error is e-mailed. Empty → log only, no e-mail.
MIXTAPE_SCAN_ALERT_EMAIL=

# --- MixTape audio streaming ---
# URI prefix of nginx's `internal;` media locations. NON-EMPTY (e.g. /internal-media)
# → the stream route hands the file off to nginx via X-Accel-Redirect, which is
# what keeps a 96GB collection from holding an fpm worker per playing song; it
# REQUIRES matching `internal;` locations in the vhost, or every stream 500s.
# EMPTY or absent (the default, and right for a dev machine with no nginx in
# front) → PHP streams the file itself, Range requests included.
# Blank and absent behave identically ON PURPOSE — a blank dotenv line is an empty
# string, not null, and treating the two differently is what broke the dev site
# once. See config/mixtape.php and docs/player.md.
MIXTAPE_STREAM_INTERNAL_PREFIX=

# --- Vite dev server (npm run dev) ---
# Local dev (e.g. mac): leave all empty — Vite serves http://localhost:5173 directly.
# Proxied dev (e.g. a remote dev box): an nginx vhost terminates TLS on :5174 and forwards to
# Vite on 127.0.0.1:5173. Set the public URL the browser uses to reach Vite:
VITE_SERVER_ORIGIN=
# Comma-separated hostnames Vite accepts in the Host header (proxied dev only):
VITE_ALLOWED_HOSTS=
# HMR websocket the browser connects to (proxied dev only; PROTOCOL defaults to wss):
VITE_HMR_HOST=
VITE_HMR_PORT=
VITE_HMR_PROTOCOL=
