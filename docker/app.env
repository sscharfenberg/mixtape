# Compose env overrides for the local Docker dev stack.
#
# These are injected as real container environment variables (compose `env_file`),
# which take precedence over the bind-mounted .env — Laravel's Dotenv is immutable
# and won't overwrite a variable that already exists in the environment. So your
# real .env (sqlite + the SSH-tunnel DB port for at-home work) stays untouched;
# inside the containers these values win instead.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# Postgres 17 in the `db` service.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mixtape
DB_USERNAME=mixtape
DB_PASSWORD=mixtape
DB_SSLMODE=disable

# Offline-friendly infra: run jobs inline (no queue worker to babysit), send mail
# to the log (storage/logs/laravel.log), keep session/cache in Postgres.
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
CACHE_STORE=database
MAIL_MAILER=log

# The browser reaches the Vite dev server on the published port; laravel-vite-plugin
# writes this origin into public/hot and vite.config reads it (via loadEnv's
# process.env merge) so asset URLs point at localhost:5173.
VITE_SERVER_ORIGIN=http://localhost:5173

# Neutralise the at-home "proxied dev" HMR settings that your real .env carries
# (VITE_HMR_HOST=debbie.local, PORT=5174, PROTOCOL=wss, plus VITE_ALLOWED_HOSTS).
# Left in place, vite.config would advertise wss://debbie.local:5174 as the HMR
# socket — unreachable from localhost, so the browser HMR client fails to connect.
# Empty here → vite.config sees them as falsy → hmr: undefined → Vite uses the
# default ws://localhost:5173, which is published and reachable.
VITE_ALLOWED_HOSTS=
VITE_HMR_HOST=
VITE_HMR_PORT=
VITE_HMR_PROTOCOL=

# Library scanner disabled by default — a laptop has no collection, and the demo
# data from LibrarySeeder fills every page. To scan real files instead: mount a
# folder into the app + vite services (see docker-compose.yml) and set these to
# its in-container path, then run:  docker compose exec app php artisan app:update
MIXTAPE_MUSIC_PATH=
MIXTAPE_AUDIOBOOKS_PATH=
